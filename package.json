{
  "name": "diamond-count",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Count numbered markers in photographs of numbered artwork, entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "tsx scripts/run-samples.ts",
    "detect": "tsx scripts/detect-test.ts",
    "crop": "tsx scripts/crop.ts",
    "measure": "tsx scripts/measure.ts",
    "cluster": "tsx scripts/cluster-test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jpeg-js": "^0.4.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
